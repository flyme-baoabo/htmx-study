<section class="space-y-6">
  <h2 class="text-2xl font-semibold text-gray-800">待办清单</h2>

  <!-- htmx 表单：POST /todos，用返回的局部片段替换 #todo-list -->
  <form
    class="flex gap-2"
    hx-post="/todos"
    hx-target="#todo-list"
    hx-swap="outerHTML"
    hx-on::after-request="if(event.detail.successful) this.reset()">
    <input
      type="text"
      name="text"
      required
      placeholder="输入要做的事…"
      class="flex-1 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm focus:border-emerald-400 focus:outline-none" />
    <button class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500">
      + 添加
    </button>
  </form>

  <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
    <div class="mb-3 flex items-center justify-between text-xs text-gray-400">
      <span>共 <%= todos.length %> 条</span>
      <!-- htmx 手动刷新列表 -->
      <button
        class="hover:text-emerald-600"
        hx-get="/todos"
        hx-target="#todo-list"
        hx-swap="outerHTML">刷新列表</button>
    </div>

    <%- include('partials/list', { todos }) %>
  </div>
</section>