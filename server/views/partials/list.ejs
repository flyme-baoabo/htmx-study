<ul class="space-y-2 p-0" id="todo-list">
  <% if (todos.length === 0) { %>
    <li class="rounded-lg bg-gray-50 p-6 text-center text-sm text-gray-400">暂无待办，添加一条吧 ✨</li>
  <% } else { %>
    <% todos.forEach((t) => { %>
      <li class="flex items-center justify-between gap-3 rounded-xl border border-gray-100 bg-white px-4 py-3 transition-colors <%= t.done ? 'bg-gray-50/60' : 'hover:border-emerald-200' %>">
        <span class="min-w-0 flex-1 text-sm <%= t.done ? 'text-gray-400 line-through' : 'text-gray-800' %>"><%= t.text %></span>
        <div class="flex shrink-0 items-center gap-2">
          <button
            class="<%= t.done ? 'btn-soft' : 'btn-primary' %>"
            data-confirm="<%= t.done ? '确定要撤销这条待办吗？' : '确定要将这条待办标记为完成吗？' %>"
            data-confirm-title="<%= t.done ? '撤销确认' : '完成确认' %>"
            data-confirm-confirm="<%= t.done ? '↩ 撤销' : '✓ 完成' %>"
            data-confirm-variant="info"
            hx-post="/todos/<%= t.id %>/toggle"
            hx-target="#todo-list"
            hx-swap="outerHTML">
            <%= t.done ? '↩ 撤销' : '✓ 完成' %>
          </button>
          <button
            class="btn-danger"
            data-confirm="删除后无法恢复，确定要删除这条待办吗？"
            data-confirm-title="删除确认"
            data-confirm-confirm="✕ 确认删除"
            data-confirm-variant="danger"
            hx-delete="/todos/<%= t.id %>"
            hx-target="#todo-list"
            hx-swap="outerHTML">
            ✕ 删除
          </button>
        </div>
      </li>
    <% }) %>
  <% } %>
</ul>