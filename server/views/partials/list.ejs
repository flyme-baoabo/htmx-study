<ul class="max-h-[260px] space-y-2 overflow-y-auto p-0" id="todo-list">
  <% if (todos.length === 0) { %>
    <li class="rounded-lg bg-gray-50 p-6 text-center text-sm text-gray-400">暂无待办，添加一条吧 ✨</li>
  <% } else { %>
    <% todos.forEach((t) => { %>
      <%- include('./item', t) %>
    <% }) %>
  <% } %>
</ul>