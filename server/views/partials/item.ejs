<li class="flex items-center justify-between gap-3 rounded-xl border border-gray-100 bg-white px-4 py-3 transition-colors <%= done ? 'bg-gray-50/60' : 'hover:border-emerald-200' %>">
    <span class="min-w-0 flex-1 text-sm <%= done ? 'text-gray-400 line-through' : 'text-gray-800' %>"><%= text %></span>
    <div class="flex shrink-0 items-center gap-2">
        <button
        class="<%= done ? 'btn-soft' : 'btn-primary' %>"
        data-confirm="<%= done ? '确定要撤销这条待办吗？' : '确定要将这条待办标记为完成吗？' %>"
        data-confirm-title="<%= done ? '撤销确认' : '完成确认' %>"
        data-confirm-confirm="<%= done ? '↩ 撤销' : '✓ 完成' %>"
        data-confirm-variant="info"
        hx-post="/todos/<%= id %>/toggle"
        hx-target="#todo-list"
        hx-swap="outerHTML">
        <%= done ? '↩ 撤销' : '✓ 完成' %>
        </button>
        <button
        class="btn-danger"
        data-confirm="删除后无法恢复，确定要删除这条待办吗？"
        data-confirm-title="删除确认"
        data-confirm-confirm="✕ 确认删除"
        data-confirm-variant="danger"
        hx-delete="/todos/<%= id %>"
        hx-target="#todo-list"
        hx-swap="outerHTML">
        ✕ 删除
        </button>
    </div>
</li>