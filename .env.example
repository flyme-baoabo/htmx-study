# ================= PostgreSQL 数据库配置【团队模板，复制为.env后填写真实值】 =================
DB_USER=
DB_PASSWORD=
DB_NAME=
# 访问数据库地址
# 宿主机运行Node填写：127.0.0.1
# Node也放入compose容器网络填写：postgres
DB_HOST=
DB_PORT=5432

# Prisma完整数据库连接串，复制到.env再启用
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ================= Redis7缓存配置 =================
REDIS_PASSWORD=
# 访问Redis地址
# 宿主机运行Node填写：127.0.0.1
# Node也放入compose容器网络填写：redis
REDIS_HOST=
REDIS_PORT=6379

# Redis连接示例，业务按需使用
# REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0"