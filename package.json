{
  "name": "htmx-project",
  "version": "1.0.0",
  "description": "This is my first htmx stdudy project",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch-path=server --watch-preserve-output server/index.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --watch --test"
  },
  "keywords": [
    "htmx"
  ],
  "author": "flyme",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "htmx.org": "^2.0.10"
  },
  "devDependencies": {
    "@unocss/cli": "^66.7.5",
    "sass": "^1.102.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "unocss": "^66.7.5",
    "vite": "^8.2.1"
  }
}
