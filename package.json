{
  "name": "htmx-study-express-vite",
  "version": "1.0.0",
  "description": "This is my first htmx study project",
  "type": "module",
  "main": "server/src/index.js",
  "scripts": {
    "dev": "node --watch-path=server --watch-preserve-output server/src/index.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node server/src/index.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --watch --test"
  },
  "keywords": [
    "htmx"
  ],
  "author": "flyme",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "htmx.org": "^2.0.10",
    "i18next": "^26.3.6",
    "i18next-http-middleware": "^3.9.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "sass": "^1.102.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
